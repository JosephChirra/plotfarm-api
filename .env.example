# =============================================
# PlotFarm Estate API — Environment Variables
# Copy this file to .env.dev for dev deployment and fill in your values
# =============================================

# --- Server ---
PORT=3001
NODE_ENV=production

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://yourdomain.com

# --- Frontend base URL (used in password reset emails) ---
APP_BASE_URL=https://yourdomain.com

# --- AWS S3 (media storage) ---
S3_ENABLED=true
S3_BUCKET_NAME=your-s3-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: custom endpoint (e.g. for MinIO or DigitalOcean Spaces)
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# S3_FORCE_PATH_STYLE=false

# --- AWS SES (transactional email) ---
SES_ENABLED=true
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=your-ses-access-key-id
SES_SECRET_ACCESS_KEY=your-ses-secret-access-key
# Must be a verified sender identity in SES
SES_SOURCE_EMAIL=noreply@yourdomain.com
SES_FROM_NAME="PlotFarm Estate"

# --- AWS SNS (mobile OTP SMS) ---
SNS_ENABLED=true
SNS_REGION=ap-south-1
SNS_ACCESS_KEY_ID=your-sns-access-key-id
SNS_SECRET_ACCESS_KEY=your-sns-secret-access-key
# Optional sender ID where supported by the destination country/operator
SNS_SENDER_ID=PLOTFARM
SNS_SMS_TYPE=Transactional
SMS_DEFAULT_COUNTRY_CODE=+91

# --- OTP security ---
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Development: skip WhatsApp/SMS/email delivery and accept a fixed OTP (default 111111).
# Enabled by default. Set to false when real OTP delivery is ready.
OTP_USE_DEV_DEFAULT=true
# OTP_DEV_DEFAULT_CODE=111111

# --- Google Maps (used in frontend) ---
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is set in plotfarm-ui/.env.local

# --- WhatsApp (Tez Solutions) ---
# Used as an OTP channel via `requestPhoneOtp(..., 'WHATSAPP')`.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=http://api.tezsolutions.in:3000/api/sendText
WHATSAPP_API_KEY=replace-me
WHATSAPP_SESSION=default
# Optional: request timeout (ms) for the WhatsApp gateway
WHATSAPP_TIMEOUT_MS=10000
# Optional: write debug logs to a specific path (defaults to ./whatsapp-debug.log).
# Set to an empty string to use the default.
# WHATSAPP_DEBUG_LOG_FILE=/tmp/whatsapp-debug.log
